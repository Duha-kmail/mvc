@page
@model IEnumerable<Library_Management_System_mvc.Models.Book>
@{
    ViewData["Title"] = "الكتب";
}

<h1>قائمة الكتب</h1>

<div class="d-flex justify-content-between mb-3">
    <a asp-action="Create" class="btn btn-primary">+ إضافة كتاب</a>

    <form asp-action="Index" method="get" class="d-flex">
        <input type="text" name="search" class="form-control me-2" placeholder="ابحث بالعنوان أو المؤلف..." />
        <button type="submit" class="btn btn-outline-secondary">بحث</button>
    </form>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>العنوان</th>
            <th>المؤلف</th>
            <th>التصنيف</th>
            <th>الحالة</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.Category?.Name</td>
                <td>
                    @if (item.IsAvailable)
                    {
                        <span class="badge bg-success">متاح</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">مستعار</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">تفاصيل</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">تعديل</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
